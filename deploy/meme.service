[Unit]
# PartOf is a personal grouping (the avicenna-suite target) — drop it if you
# don't run that target, and adjust WorkingDirectory/ReadWritePaths to your own
# checkout before installing.
PartOf=avicenna-suite.target
Description=Mimema (meme generator + media host)
Wants=network-online.target
After=network-online.target

[Service]
WorkingDirectory=%h/Documents/side/mimema
ExecStart=/usr/bin/node --env-file-if-exists=.env server/index.ts
Restart=always
RestartSec=5
Environment=NODE_ENV=production

# sandboxing — no MemoryDenyWriteExecute, it breaks the V8 JIT
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/Documents/side/mimema/data
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
SystemCallFilter=@system-service
MemoryMax=1G
TasksMax=128

[Install]
WantedBy=default.target
