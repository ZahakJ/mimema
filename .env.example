# Copy to .env. Read with --env-file-if-exists.

# Key for publishing, uploading, adding templates and deleting. Empty disables
# writes. The server warns below 12 characters.  openssl rand -base64 24
INVITE_KEY=

HOST=127.0.0.1
PORT=8001

# Origin for OpenGraph URLs. Default http://localhost:<PORT>.
PUBLIC_ORIGIN=https://memes.example.com

# Database, media and templates. Default ./data.
#DATA_DIR=/srv/mimema/data

# 0 refuses MP4/WebM uploads.
ALLOW_VIDEO=1

# Per-IP requests per window. RATE_LIMIT=0 disables.
#RATE_LIMIT=1
#RATE_LIMIT_VERIFY=10
#RATE_LIMIT_WRITE=30
#RATE_LIMIT_READ=120
#RATE_LIMIT_REACT=60
#RATE_LIMIT_WINDOW_MS=60000

# ————— relay (optional) —————
# Loopback only; it has no auth.
#MEME_RELAY_PORT=8006
# API the relay reads and posts to.
#MEME_ORIGIN=http://127.0.0.1:8001
# Origin for returned URLs.
#MEME_PUBLIC_ORIGIN=https://meme.avicenna.space
# `claude --model` aliases for /forge and /digest.
#MEME_RELAY_MODEL=sonnet
#MEME_NEWS_MODEL=opus
# Per-chatId cooldown in ms; 0 is off.
#MEME_RELAY_COOLDOWN_MS=0
