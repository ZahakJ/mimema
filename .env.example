# Copy to .env and fill in. The server reads this via --env-file-if-exists.

# The invite passphrase friends use to publish/upload/add templates/delete.
# It is the ONLY thing guarding every write route, so make it long — short keys
# are brute-forceable and the server prints a boot warning under 12 chars.
# Generate one:  openssl rand -base64 24
# Leave empty to disable publishing entirely.
INVITE_KEY=

# Where the tunnel points. Prod is 8001 (Cloudflare ingress); dev server uses 5900.
HOST=127.0.0.1
PORT=8001

# Absolute URLs in OpenGraph tags are built from this — set it to your own
# public origin. Defaults to http://localhost:<PORT> when unset.
PUBLIC_ORIGIN=https://memes.example.com

# Media + sqlite live here (gitignored). Defaults to ./data next to the repo.
#DATA_DIR=/srv/mimema/data

# Set to 0 to refuse video uploads (mp4/webm).
ALLOW_VIDEO=1

# Per-IP rate limits (requests per window). RATE_LIMIT=0 turns the limiter off.
#RATE_LIMIT_VERIFY=10
#RATE_LIMIT_WRITE=30
#RATE_LIMIT_READ=120
# Emoji reactions are public and cheap — their own, roomier bucket.
#RATE_LIMIT_REACT=60
#RATE_LIMIT_WINDOW_MS=60000

# ————— relay (optional; see the Relay section of the README) —————
# The loopback daemon that turns a chat transcript POSTed to /forge into a meme
# on the wall — the only part of Mimema that talks to a model; the app has no
# AI. Don't run the unit and nothing else cares. Binary (the Go Discord bot) is
# the only client; it POSTs, so no token lives here.
# Where the daemon listens. Loopback only (127.0.0.1 + ::1) — never expose it:
# there is no auth on /forge, by design.
#MEME_RELAY_PORT=8006
# Where the relay reads the catalog and posts the finished meme (the local API).
#MEME_ORIGIN=http://127.0.0.1:8001
# Only used to absolutize the relative URLs the API returns, for chat links.
#MEME_PUBLIC_ORIGIN=https://meme.avicenna.space
# Model for the picker — any alias `claude --model` accepts. Default: sonnet.
#MEME_RELAY_MODEL=sonnet   # default; set opus/fable for wittier, ~10x pricier picks
# Cooldown between forges per caller chatId, milliseconds (default 30000).
#MEME_RELAY_COOLDOWN_MS=0   # per-chatId backstop; off by default — Binary enforces per-user limits
